# SmartPrint Environment Configuration Example
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartprint-college-campus-secret-key-2026-secure

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smartprint_db

# Document Upload Settings
MAX_UPLOAD_SIZE_MB=15
UPLOAD_FOLDER=uploads/documents

# Printer Settings
PRINTER_MODE=simulation
CUPS_SERVER_HOST=localhost
CUPS_SERVER_PORT=631
PRINTER_NAME=Campus_Xerox_Main

# Default Pricing
PRICE_BW_PER_PAGE=2.0
PRICE_COLOR_PER_PAGE=5.0
PRICE_DUPLEX_PAGE=2.0
