# SmartPrint Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartprint-college-campus-secret-key-2026-secure

# MySQL Database Configuration (XAMPP MariaDB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smartprint_db

# Document Upload Settings
MAX_UPLOAD_SIZE_MB=15
UPLOAD_FOLDER=uploads/documents

# Printer Settings
# Options: 'simulation' (demo/testing), 'cups' (CUPS print server), 'windows_spooler'
PRINTER_MODE=simulation
CUPS_SERVER_HOST=localhost
CUPS_SERVER_PORT=631
PRINTER_NAME=Campus_Xerox_Main

# Default Pricing (in INR ₹)
PRICE_BW_PER_PAGE=2.0
PRICE_COLOR_PER_PAGE=5.0
PRICE_DUPLEX_PAGE=2.0

# Campus Metadata
CAMPUS_NAME=Central College Campus Xerox
SHOP_LOCATION=Ground Floor, Student Activity Centre (SAC)
SHOP_HOURS=8:30 AM - 6:30 PM (Mon - Sat)
